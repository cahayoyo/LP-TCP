---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, services, steps, projects, needs } from '../data/site';
import { saveContact } from '../lib/contact';
import heroPhoto from '../assets/ipa-1.png';

let status: 'ok' | 'error' | null = null;
let errorMessage = '';

if (Astro.request.method === 'POST') {
  try {
    const result = await saveContact(await Astro.request.formData());
    return Astro.redirect(result.ok ? '/?terkirim=1#kontak' : '/?gagal=1#kontak', 303);
  } catch (err) {
    console.error('contact form failed:', err);
    return Astro.redirect('/?gagal=1#kontak', 303);
  }
}

if (Astro.url.searchParams.has('terkirim')) status = 'ok';
if (Astro.url.searchParams.has('gagal')) {
  status = 'error';
  errorMessage = 'Pesan gagal dikirim. Coba lagi atau hubungi kami lewat email.';
}
---

<Base>
  <Header />

  <main id="main">
    <section class="hero" id="beranda">
      <Image
        src={heroPhoto}
        alt="Instalasi Pengolahan Air (IPA) baja milik PT. Tri Cipta Patriot"
        width={1672}
        height={941}
        format="webp"
        quality={82}
        class="hero__bg"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__shade" aria-hidden="true"></div>

      <div class="wrap hero__inner">
        <span class="eyebrow">Kontraktor Spesialis Pengolahan Air</span>
        <h1>Solusi Terpadu<br />Instalasi <span class="hl">Pengolahan<br />Air</span> (IPA) Baja</h1>
        <p class="hero__lead">
          {site.name} adalah perusahaan kontraktor yang berfokus pada konstruksi, fabrikasi,
          dan instalasi pengolahan air berbasis baja dengan dukungan workshop sendiri di
          Purwakarta.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary" href="#kontak">
            Minta Penawaran
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn__icon">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
          <a class="btn btn--ghost" href="#proyek">
            Lihat Projek Kami
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn__icon">
              <path d="M5 12h14M13 6l6 6-6 6"></path>
            </svg>
          </a>
        </div>

        <ul class="hero__stats">
          <li>
            <svg class="hero__stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 20h18"></path>
              <path d="M5 20V7.5L11 5l6 2.5V20"></path>
              <path d="M9 20v-5h4v5"></path>
              <path d="M8 10h.01M11 10h.01M14 10h.01"></path>
            </svg>
            <span>Workshop<br />Fabrikasi Sendiri</span>
            <small class="stat-sub--mobile">di Purwakarta, Jawa Barat</small>
          </li>
          <li>
            <svg class="hero__stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3c3.5 4.6 6 8 6 11a6 6 0 0 1-12 0c0-3 2.5-6.4 6-11Z"></path>
            </svg>
            <span>
              <span class="stat-swap--desktop">10–50 L/detik</span>
              <span class="stat-swap--mobile">10–50 Liter/Detik</span>
            </span>
            <small>Kapasitas IPA</small>
          </li>
          <li>
            <svg class="hero__stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <g transform="rotate(45 12 12)">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </g>
              <g transform="rotate(-45 12 12)">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </g>
            </svg>
            <span>Fabrikasi hingga<br />Commissioning</span>
            <small class="stat-sub--mobile">Solusi End-to-End</small>
          </li>
        </ul>
      </div>

      <svg class="hero__wave" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0,64 C220,108 480,116 730,92 C980,68 1220,28 1440,56 L1440,130 L0,130 Z"
          fill="#4e9be0"
          opacity="0.6"></path>
        <path
          d="M0,86 C240,124 500,128 750,100 C1000,72 1240,46 1440,76 L1440,130 L0,130 Z"
          fill="#ffffff"></path>
      </svg>
    </section>

    <section class="section" id="tentang">
      <div class="wrap split">
        <div>
          <span class="eyebrow">Tentang kami</span>
          <h2>Fokus pada satu hal: air yang memenuhi standar.</h2>
          <p class="lead">
            Instalasi pengolahan air bukan sekadar susunan tangki dan pompa. Kualitas hasil
            akhir bergantung pada desain proses yang tepat, pemasangan yang rapi, dan
            pengaturan operasi yang konsisten.
          </p>
          <p>
            Kami bekerja dari analisis sumber air di awal, menyusun desain proses, membangun
            unit di lokasi, lalu mendampingi operasi sampai kualitas air sesuai target yang
            disepakati.
          </p>
        </div>

        <ul class="stat-list">
          <li>
            <strong>Satu titik tanggung jawab</strong>
            <span>Desain, konstruksi, dan commissioning ditangani tim yang sama.</span>
          </li>
          <li>
            <strong>Desain mengikuti sumber air</strong>
            <span>Parameter air baku menentukan proses, bukan sebaliknya.</span>
          </li>
          <li>
            <strong>Mudah dioperasikan</strong>
            <span>Operator dilibatkan sejak commissioning dan diberi pelatihan.</span>
          </li>
        </ul>
      </div>
    </section>

    <section class="section section--surface" id="layanan">
      <div class="wrap">
        <span class="eyebrow">Layanan</span>
        <h2>Yang kami kerjakan</h2>
        <p class="lead" style="margin-bottom: 2.5rem;">
          Lingkup pekerjaan disesuaikan dengan kondisi lokasi dan kebutuhan kapasitas.
        </p>

        <div class="cards">
          {services.map((s) => (
            <article class="card">
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
              <ul class="checklist">
                {s.points.map((p) => <li>{p}</li>)}
              </ul>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="proses">
      <div class="wrap">
        <span class="eyebrow">Alur kerja</span>
        <h2>Empat tahap, satu hasil yang terukur</h2>
        <p class="lead" style="margin-bottom: 2.5rem;">
          Setiap tahap punya keluaran yang jelas, sehingga progres proyek mudah dipantau.
        </p>

        <ol class="steps">
          {steps.map((s) => (
            <li>
              <h3>{s.title}</h3>
              <p>{s.desc}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="section section--surface" id="proyek">
      <div class="wrap">
        <span class="eyebrow">Proyek</span>
        <h2>Contoh lingkup pekerjaan</h2>
        <p class="lead" style="margin-bottom: 2.5rem;">
          Foto dan data proyek akan diperbarui pada bagian ini.
        </p>

        <div class="cards">
          {projects.map((p) => (
            <article class="project">
              <img src={p.image} alt={p.alt} width="640" height="400" loading="lazy" />
              <div class="project__body">
                <h3>{p.title}</h3>
                <p>{p.meta}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="section" id="kontak">
      <div class="wrap">
        <span class="eyebrow">Kontak</span>
        <h2>Ceritakan kebutuhan instalasi Anda</h2>
        <p class="lead" style="margin-bottom: 2.5rem;">
          Isi formulir di bawah, kami akan menghubungi Anda untuk membahas kebutuhan teknis.
        </p>

        {status === 'ok' && (
          <div class="alert alert--ok" role="status" aria-live="polite">
            Terima kasih. Pesan Anda sudah kami terima dan akan segera ditindaklanjuti.
          </div>
        )}
        {status === 'error' && (
          <div class="alert alert--error" role="alert">{errorMessage}</div>
        )}

        <div class="contact-grid">
          <form class="form" method="post" action="#kontak" novalidate>
            <div class="field">
              <label for="name">Nama <span aria-hidden="true">*</span></label>
              <input id="name" name="name" type="text" required maxlength="100" autocomplete="name" />
            </div>

            <div class="field">
              <label for="company">Perusahaan</label>
              <input id="company" name="company" type="text" maxlength="150" autocomplete="organization" />
            </div>

            <div class="field">
              <label for="email">Email <span aria-hidden="true">*</span></label>
              <input id="email" name="email" type="email" required maxlength="254" autocomplete="email" />
            </div>

            <div class="field">
              <label for="phone">Telepon / WhatsApp</label>
              <input id="phone" name="phone" type="tel" maxlength="40" autocomplete="tel" />
            </div>

            <div class="field field--full">
              <label for="need">Kebutuhan</label>
              <select id="need" name="need">
                <option value="">Pilih kebutuhan</option>
                {needs.map((n) => <option value={n}>{n}</option>)}
              </select>
            </div>

            <div class="field field--full">
              <label for="message">Pesan <span aria-hidden="true">*</span></label>
              <textarea
                id="message"
                name="message"
                required
                minlength="10"
                maxlength="5000"
                placeholder="Contoh: butuh WTP kapasitas 20 liter/detik dengan sumber air sungai, lokasi di Jawa Barat."
              ></textarea>
              <span class="field__hint">Sertakan kapasitas, sumber air, dan lokasi bila sudah ada.</span>
            </div>

            <div class="hp" aria-hidden="true">
              <label for="website">Website</label>
              <input id="website" name="website" type="text" tabindex="-1" autocomplete="off" />
            </div>

            <div class="form__foot">
              <p>
                Data yang Anda kirim hanya digunakan untuk menindaklanjuti permintaan ini.
              </p>
              <button class="btn btn--primary" type="submit">Kirim pesan</button>
            </div>
          </form>

          <dl class="contact-info">
            <div class="contact-info__item">
              <dt>Email</dt>
              <dd><a href={`mailto:${site.email}`}>{site.email}</a></dd>
            </div>
            <div class="contact-info__item">
              <dt>Telepon</dt>
              <dd><a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a></dd>
            </div>
            <div class="contact-info__item">
              <dt>Alamat</dt>
              <dd>{site.address}</dd>
            </div>
            <div class="contact-info__item">
              <dt>Jam kerja</dt>
              <dd>{site.hours}</dd>
            </div>
          </dl>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Base>
