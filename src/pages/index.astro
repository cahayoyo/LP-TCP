---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ClientCard from '../components/ClientCard.astro';
import StandardsPanel from '../components/StandardsPanel.astro';
import { site, workshop, projects, ipaSizes, clients } from '../data/site';
import MapIndonesia from '../components/MapIndonesia.astro';
import heroPhoto from '../assets/ipa-1.png';

// Konten tetap dan gambar disiapkan saat build agar request awal tidak menunggu transformasi.
export const prerender = true;
---

<Base>
  <Header />

  <main id="main">
    <section class="hero" id="beranda">
      <Image
        src={heroPhoto}
        alt="Instalasi Pengolahan Air (IPA) baja milik PT. Tri Cipta Patriot"
        width={1672}
        height={941}
        format="webp"
        quality={72}
        widths={[400, 640, 750, 960, 1280, 1672]}
        sizes="(max-width: 991px) 100vw, 1100px"
        class="hero__bg"
        loading="eager"
        fetchpriority="high"
      />
      <div class="hero__shade" aria-hidden="true"></div>

      <div class="wrap hero__inner">
        <span class="eyebrow">Water Treatment Plant Specialist</span>
        <h1>Instalasi Pengolahan<br />Air (IPA) Baja</h1>
        <p class="hero__lead">
          {site.name} adalah perusahaan kontraktor yang bergerak di bidang konstruksi air
          bersih. Spesialisasi pada pembuatan &amp; pembangunan instalasi pengolahan air
          struktur baja.
        </p>

        <div class="hero__actions">
          <a class="btn btn--primary" href="https://katalog.inaproc.id/tri-cipta-patriot" target="_blank" rel="noopener noreferrer">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn__icon">
              <path d="M5 8h14l-1.2 12.2a1.8 1.8 0 0 1-1.8 1.8H8a1.8 1.8 0 0 1-1.8-1.8L5 8Z"></path>
              <path d="M9 8V6a3 3 0 0 1 6 0v2"></path>
            </svg>
            E-Katalog V6
          </a>
          <button type="button" class="btn btn--ghost" data-open-map>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="btn__icon">
              <path d="M12 21s-7-5.1-7-11a7 7 0 0 1 14 0c0 5.9-7 11-7 11Z"></path>
              <circle cx="12" cy="10" r="2.5"></circle>
            </svg>
            Lokasi Workshop
          </button>
        </div>

        <ul class="hero__stats">
          <li>
            <svg class="hero__stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M3 20h18"></path>
              <path d="M5 20V7.5L11 5l6 2.5V20"></path>
              <path d="M9 20v-5h4v5"></path>
              <path d="M8 10h.01M11 10h.01M14 10h.01"></path>
            </svg>
            <span>Workshop IPA TCP</span>
            <small class="stat-sub--mobile">Purwakarta, Jawa Barat</small>
          </li>
          <li>
            <svg class="hero__stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M12 3c3.5 4.6 6 8 6 11a6 6 0 0 1-12 0c0-3 2.5-6.4 6-11Z"></path>
            </svg>
            <span>
              <span class="stat-swap--desktop">10 - 50 Liter / Detik</span>
              <span class="stat-swap--mobile">10–50 Liter/Detik</span>
            </span>
            <small>Kapasitas IPA</small>
          </li>
          <li>
            <svg class="hero__stat-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <g transform="rotate(45 12 12)">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </g>
              <g transform="rotate(-45 12 12)">
                <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"></path>
              </g>
            </svg>
            <span>Fabrikasi hingga<br />Commissioning</span>
            <small class="stat-sub--mobile">End to End</small>
          </li>
        </ul>
      </div>

      <svg class="hero__wave" viewBox="0 0 1440 130" preserveAspectRatio="none" aria-hidden="true">
        <path
          d="M0,64 C220,108 480,116 730,92 C980,68 1220,28 1440,56 L1440,130 L0,130 Z"
          fill="#4e9be0"
          opacity="0.6"></path>
        <path
          d="M0,86 C240,124 500,128 750,100 C1000,72 1240,46 1440,76 L1440,130 L0,130 Z"
          fill="#ffffff"></path>
      </svg>
    </section>

    <section class="section" id="ipa">
      <div class="wrap wrap--wide">
        <div class="ipa-head">
          <h2>IPA Struktur Baja</h2>
          <p class="ipa-sub">Pilihan Kapasitas Instalasi Pengolahan Air</p>
        </div>

        <div class="ipa-grid">
          {ipaSizes.map((s) => (
            <article class="ipa-card">
              <Image
                src={s.image}
                alt={s.alt}
                width={900}
                widths={[200, 320, 400, 480, 640, 800, 1200, 1600]}
                sizes="(max-width: 640px) calc(56vw - 30px), (max-width: 800px) calc(46vw - 38px), (max-width: 1700px) calc(50vw - 70px), 780px"
                format="webp"
                quality={70}
                loading="lazy"
                class="ipa-card__img"
              />
              <p class="ipa-card__cap">
                <svg viewBox="0 0 32 40" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M16 3c3 5.2 11 13.7 11 22.5a11 11 0 0 1-22 0C5 16.7 13 8.2 16 3Z"></path>
                </svg>
                <span><strong>{s.capacity}</strong> Liter/Detik</span>
              </p>
            </article>
          ))}
        </div>

        <StandardsPanel />
      </div>
    </section>

    <section class="section section--surface" id="workshop">
      <div class="wrap wrap--wide">
        <div class="ipa-head">
          <h2>Workshop TCP</h2>
          <p class="ipa-sub">{workshop.sub}</p>
        </div>

        <div class="ws-grid">
          <figure class="ws-photo" data-carousel>
            <ul class="ws-slides" data-track>
              {workshop.slides.map((s) => (
                <li>
                  <Image
                    src={s.image}
                    alt={s.alt}
                    width={1200}
                    height={923}
                    widths={[320, 480, 640, 720, 960, 1200, 1600]}
                    sizes="(max-width: 695px) 92vw, (max-width: 991px) 640px, (max-width: 1700px) calc(52vw - 60px), 828px"
                    format="webp"
                    quality={72}
                    loading="lazy"
                  />
                </li>
              ))}
            </ul>
            <button class="ws-arrow ws-arrow--side ws-arrow--left" type="button" data-prev aria-label="Foto sebelumnya">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M19 12H5"></path>
                <path d="m12 19-7-7 7-7"></path>
              </svg>
            </button>
            <button class="ws-arrow ws-arrow--side ws-arrow--right" type="button" data-next aria-label="Foto berikutnya">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M5 12h14"></path>
                <path d="m12 5 7 7-7 7"></path>
              </svg>
            </button>
            <div class="car-dots car-dots--corner" data-dots aria-label="Posisi foto"></div>
            <div class="ws-area">
              <span class="ws-area__icon" aria-hidden="true">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                  <circle cx="12" cy="10" r="3"></circle>
                </svg>
              </span>
              <span class="ws-area__text">
                <small>{workshop.locationLabel}</small>
                <strong>{workshop.location}</strong>
              </span>
            </div>
          </figure>

          <div class="ws-copy">
            <p class="ws-eyebrow">{workshop.eyebrow}</p>
            <h3>{workshop.heading}</h3>
            <p>{workshop.desc}</p>

            <ul class="ws-features">
              {workshop.features.map((f) => (
                <li class="ws-feature">
                  {f.icon === 'gear' && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M19.14 12.94c.04-.3.06-.61.06-.94 0-.32-.02-.64-.07-.94l2.03-1.58a.49.49 0 0 0 .12-.61l-1.92-3.32a.49.49 0 0 0-.59-.22l-2.39.96c-.5-.38-1.03-.7-1.62-.94l-.36-2.54a.48.48 0 0 0-.48-.41h-3.84c-.24 0-.43.17-.47.41l-.36 2.54c-.59.24-1.13.57-1.62.94l-2.39-.96c-.22-.08-.47 0-.59.22L2.74 8.87c-.12.21-.08.47.12.61l2.03 1.58c-.05.3-.09.63-.09.94s.02.64.07.94l-2.03 1.58a.49.49 0 0 0-.12.61l1.92 3.32c.12.22.37.29.59.22l2.39-.96c.5.38 1.03.7 1.62.94l.36 2.54c.05.24.24.41.48.41h3.84c.24 0 .44-.17.47-.41l.36-2.54c.59-.24 1.13-.56 1.62-.94l2.39.96c.22.08.47 0 .59-.22l1.92-3.32c.12-.22.07-.47-.12-.61l-2.01-1.58ZM12 15.6a3.6 3.6 0 1 1 0-7.2 3.6 3.6 0 0 1 0 7.2Z"></path>
                    </svg>
                  )}
                  {f.icon === 'users' && (
                    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M9 11.2a3.4 3.4 0 1 0 0-6.8 3.4 3.4 0 0 0 0 6.8Zm7 .4a2.8 2.8 0 1 0 0-5.6 2.8 2.8 0 0 0 0 5.6ZM9 13c-3.1 0-6 1.6-6 3.9V19h12v-2.1c0-2.3-2.9-3.9-6-3.9Zm7 .5c-.5 0-1 .05-1.5.15 1.4.9 2 2.1 2 3.25V19h4.5v-1.8c0-1.9-2.5-3.7-5-3.7Z"></path>
                    </svg>
                  )}
                  {f.icon === 'shield' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M12 2 4 5.2v5.4c0 5 3.4 9.6 8 10.9 4.6-1.3 8-5.9 8-10.9V5.2L12 2Z"></path>
                      <path fill="#fff" d="m10.4 15.1-3.2-3.2 1.4-1.4 1.8 1.8 4.4-4.4 1.4 1.4-5.8 5.8Z"></path>
                    </svg>
                  )}
                  {f.icon === 'clock' && (
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path fill="currentColor" d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z"></path>
                      <path fill="#fff" d="M12.9 6.6h-1.8v6.2l5.1 3 .9-1.4-4.2-2.5V6.6Z"></path>
                    </svg>
                  )}
                  <span>{f.label}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="ws-doc" data-carousel>
          <div class="ws-doc__head">
            <div>
              <span class="ws-doc__pill">Aktivitas</span>
              <h3>{workshop.docTitle}</h3>
            </div>
            <div class="ws-doc__side">
              <p>{workshop.docDesc}</p>
              <div class="ws-arrows">
                <button class="ws-arrow" type="button" data-prev aria-label="Geser galeri ke kiri">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M19 12H5"></path>
                    <path d="m12 19-7-7 7-7"></path>
                  </svg>
                </button>
                <button class="ws-arrow" type="button" data-next aria-label="Geser galeri ke kanan">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M5 12h14"></path>
                    <path d="m12 5 7 7-7 7"></path>
                  </svg>
                </button>
              </div>
            </div>
          </div>

          <ul class="ws-track" data-track>
            {workshop.gallery.map((g) => (
              <li class="ws-item">
                {typeof g.image === 'string' ? (
                  <img src={g.image} alt={g.alt} width="480" height="360" loading="lazy" />
                ) : (
                  <Image
                    src={g.image}
                    alt={g.alt}
                    width={480}
                    height={360}
                    widths={[200, 320, 400, 480, 560, 640, 800]}
                    sizes="(max-width: 530px) calc(72vw - 42px), (max-width: 640px) 340px, (max-width: 1700px) calc(20vw - 40px), 300px"
                    format="webp"
                    quality={70}
                    loading="lazy"
                  />
                )}
                <p>{g.caption}</p>
              </li>
            ))}
          </ul>

          <div class="car-dots" data-dots aria-label="Posisi galeri"></div>
        </div>
      </div>
    </section>

    <!-- Modal peta workshop: iframe dimuat hanya saat pertama dibuka -->
    <div class="map-modal" data-map-modal hidden>
      <div class="map-modal__backdrop" data-map-close></div>
      <div class="map-modal__panel" role="dialog" aria-modal="true" aria-label="Lokasi Workshop PT. Tri Cipta Patriot">
        <button type="button" class="map-modal__close" data-map-close aria-label="Tutup peta">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
        <iframe
          data-map-frame
          title="Peta Lokasi Workshop PT. Tri Cipta Patriot"
          data-src="https://maps.google.com/maps?q=-6.6830985,107.4245719&z=17&output=embed"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
      </div>
    </div>

    <script>
      // Semua carousel workshop: panah dinamis, dots posisi, dan swipe mouse.
      for (const root of document.querySelectorAll<HTMLElement>('[data-carousel]')) {
        const track = root.querySelector<HTMLElement>('[data-track]');
        const prev = root.querySelector<HTMLButtonElement>('[data-prev]');
        const next = root.querySelector<HTMLButtonElement>('[data-next]');
        const dotsBox = root.querySelector<HTMLElement>('[data-dots]');

        if (!track || !prev || !next) continue;
        const step = () => (track.firstElementChild?.clientWidth ?? 280) + 16;

        // Panah redup saat carousel mentok kiri/kanan.
        const updateArrows = () => {
          const max = track.scrollWidth - track.clientWidth;
          prev.disabled = track.scrollLeft <= 2;
          next.disabled = track.scrollLeft >= max - 2;
        };

        prev.addEventListener('click', () => track.scrollBy({ left: -step(), behavior: 'smooth' }));
        next.addEventListener('click', () => track.scrollBy({ left: step(), behavior: 'smooth' }));

        // Dots: satu per posisi geser (total slide - jumlah slide terlihat + 1).
        let dots: HTMLButtonElement[] = [];
        const updateDots = () => {
          const i = Math.min(dots.length - 1, Math.max(0, Math.round(track.scrollLeft / step())));
          for (const [j, d] of dots.entries()) {
            d.classList.toggle('is-active', j === i);
            d.setAttribute('aria-current', j === i ? 'true' : 'false');
          }
        };
        const build = () => {
          if (!dotsBox) return;
          dotsBox.innerHTML = '';
          dots = [];
          const visible = Math.max(1, Math.round((track.clientWidth + 16) / step()));
          const count = Math.max(1, track.children.length - visible + 1);
          for (let i = 0; i < count; i++) {
            const d = document.createElement('button');
            d.type = 'button';
            d.className = 'car-dot';
            d.setAttribute('aria-label', `Ke posisi ${i + 1}`);
            d.addEventListener('click', () =>
              track.scrollTo({ left: i * step(), behavior: 'smooth' }),
            );
            dotsBox.append(d);
            dots.push(d);
          }
          updateDots();
        };

        let raf = 0;
        track.addEventListener('scroll', () => {
          cancelAnimationFrame(raf);
          raf = requestAnimationFrame(() => {
            updateDots();
            updateArrows();
          });
        });
        window.addEventListener('resize', () => {
          build();
          updateArrows();
        });
        build();
        updateArrows();

        // Swipe pakai mouse: drag di track (sentuh tetap pakai scroll native).
        let dragging = false;
        let dragX = 0;
        let dragLeft = 0;

        track.addEventListener('pointerdown', (e) => {
          if (e.pointerType !== 'mouse' || e.button !== 0) return;
          dragging = true;
          dragX = e.clientX;
          dragLeft = track.scrollLeft;
          track.classList.add('is-drag');
          track.setPointerCapture(e.pointerId);
        });
        track.addEventListener('pointermove', (e) => {
          if (dragging) track.scrollLeft = dragLeft - (e.clientX - dragX);
        });
        const endDrag = () => {
          dragging = false;
          track.classList.remove('is-drag');
        };
        track.addEventListener('pointerup', endDrag);
        track.addEventListener('pointercancel', endDrag);
        track.addEventListener('dragstart', (e) => e.preventDefault());
      }
    </script>

    <script>
      // Modal peta: iframe baru diset src saat pertama dibuka, agar peta tidak dimuat di awal.
      const mapModal = document.querySelector<HTMLElement>('[data-map-modal]');
      const mapFrame = mapModal?.querySelector<HTMLIFrameElement>('[data-map-frame]');
      let lastTrigger: HTMLElement | null = null;

      const openMap = () => {
        if (!mapModal || !mapFrame) return;
        if (!mapFrame.src) mapFrame.src = mapFrame.dataset.src ?? '';
        lastTrigger = document.activeElement as HTMLElement | null;
        mapModal.hidden = false;
        document.body.style.overflow = 'hidden';
        // Fokus pindah ke tombol tutup supaya keyboard tidak tertinggal di belakang overlay.
        mapModal.querySelector<HTMLElement>('.map-modal__close')?.focus();
      };

      const closeMap = () => {
        if (!mapModal) return;
        mapModal.hidden = true;
        document.body.style.overflow = '';
        lastTrigger?.focus();
      };

      for (const trigger of document.querySelectorAll('[data-open-map]')) {
        trigger.addEventListener('click', openMap);
      }
      for (const closer of mapModal?.querySelectorAll('[data-map-close]') ?? []) {
        closer.addEventListener('click', closeMap);
      }
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && !mapModal?.hidden) closeMap();
      });
    </script>

    <section class="section" id="proyek">
      <div class="wrap wrap--wide">
        <div class="pr-head">
          <h2>Portofolio Proyek</h2>
        </div>

        <div class="pr-group" data-carousel>
          <div class="pr-group__head">
            <h3>IPA Struktur Baja</h3>
            <div class="ws-arrows">
              <button class="ws-arrow" type="button" data-prev aria-label="Geser proyek IPA ke kiri">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 12H5"></path>
                  <path d="m12 19-7-7 7-7"></path>
                </svg>
              </button>
              <button class="ws-arrow" type="button" data-next aria-label="Geser proyek IPA ke kanan">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </button>
            </div>
          </div>

          <ul class="pr-track" data-track>
            {projects.filter((p) => p.tag === 'IPA Baja').map((p) => <ProjectCard p={p} />)}
          </ul>

          <div class="car-dots" data-dots aria-label="Posisi proyek IPA"></div>
        </div>

        <div class="pr-group" data-carousel>
          <div class="pr-group__head">
            <h3>General</h3>
            <div class="ws-arrows">
              <button class="ws-arrow" type="button" data-prev aria-label="Geser proyek general ke kiri">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M19 12H5"></path>
                  <path d="m12 19-7-7 7-7"></path>
                </svg>
              </button>
              <button class="ws-arrow" type="button" data-next aria-label="Geser proyek general ke kanan">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M5 12h14"></path>
                  <path d="m12 5 7 7-7 7"></path>
                </svg>
              </button>
            </div>
          </div>

          <ul class="pr-track" data-track>
            {projects.filter((p) => p.tag !== 'IPA Baja').map((p) => <ProjectCard p={p} />)}
          </ul>

          <div class="car-dots" data-dots aria-label="Posisi proyek general"></div>
        </div>
      </div>
    </section>

    <section class="section section--surface" id="pengguna-jasa">
      <div class="wrap wrap--wide">
        <div class="cl-head">
          <h2>Pengguna Jasa</h2>
          <div class="cl-map">
            <MapIndonesia class="cl-map__svg" />
          </div>
        </div>

        <div class="cl-carousel" data-carousel>
          <ul class="cl-track" data-track>
            {clients.map((c) => <ClientCard c={c} />)}
          </ul>
          <button class="cl-arrow cl-arrow--prev" type="button" data-prev aria-label="Geser instansi ke kiri">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m15 19-7-7 7-7"></path>
            </svg>
          </button>
          <button class="cl-arrow cl-arrow--next" type="button" data-next aria-label="Geser instansi ke kanan">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="m9 5 7 7-7 7"></path>
            </svg>
          </button>
