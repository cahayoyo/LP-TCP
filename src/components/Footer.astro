---
import { Image } from 'astro:assets';
import logo from '../assets/logo-tcpbiru.png';
import workshop1 from '../assets/workshop-1.png';
import { site, nav, socials } from '../data/site';

const year = new Date().getFullYear();
---

<!-- Footer: biru gelap + poligon diagonal + foto workshop redup di kanan -->
<footer class="site-footer">
  <Image
    src={workshop1}
    alt=""
    width={1200}
    loading="lazy"
    class="site-footer__photo"
    aria-hidden="true"
  />
  <div class="site-footer__shape" aria-hidden="true"></div>

  <div class="wrap">
    <div class="footer-grid">
      <div class="footer-brand">
        <Image
          src={logo}
          alt="PT. Tri Cipta Patriot — Water Treatment Specialist"
          width={180}
          format="webp"
          quality={88}
          class="footer-brand__logo"
          loading="lazy"
        />
        <p class="footer-brand__desc">
          {site.tagline}. Melayani perencanaan, konstruksi, dan pemeliharaan instalasi pengolahan air.
        </p>
        <div class="footer-social">
          {socials.map((s) => (
            <a href={s.href} aria-label={s.label}>
              {s.icon === 'linkedin' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 6.28v5.46zM5.34 7.43a2.06 2.06 0 1 1 0-4.13 2.06 2.06 0 0 1 0 4.13zM7.12 20.45H3.55V9h3.57v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.45c.98 0 1.78-.77 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"></path>
                </svg>
              )}
              {s.icon === 'instagram' && (
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                  <circle cx="12" cy="12" r="4"></circle>
                  <path d="M17.2 6.8h.01"></path>
                </svg>
              )}
              {s.icon === 'youtube' && (
                <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                  <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.87.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81zM9.55 15.57V8.43L15.82 12l-6.27 3.57z"></path>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <nav class="footer-col" aria-label="Navigasi footer">
        <h3>Navigasi</h3>
        <ul>
          {nav.map((item) => (
            <li>
              <a href={item.href}>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="m9 6 6 6-6 6"></path>
                </svg>
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="footer-col">
        <h3>Kontak</h3>
        <ul class="footer-contact">
          <li>
            <span class="footer-contact__badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                <path d="m3 7 9 6 9-6"></path>
              </svg>
            </span>
            <a href={`mailto:${site.email}`}>{site.email}</a>
          </li>
          <li>
            <span class="footer-contact__badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.13.96.36 1.9.7 2.8a2 2 0 0 1-.45 2.1L8.1 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.45c.9.34 1.84.57 2.8.7a2 2 0 0 1 1.7 2.05Z"></path>
              </svg>
            </span>
            <a href={`tel:${site.phone.replace(/[^+\d]/g, '')}`}>{site.phone}</a>
          </li>
          <li>
            <span class="footer-contact__badge" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
                <circle cx="12" cy="10" r="3"></circle>
              </svg>
            </span>
            <span>{site.address}</span>
          </li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <span>© {year} {site.name}. Seluruh hak dilindungi.</span>
    </div>
  </div>
</footer>
