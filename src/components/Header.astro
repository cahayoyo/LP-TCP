---
import { site, nav } from '../data/site';
---

<header class="site-header">
  <div class="wrap site-header__inner">
    <a class="brand" href="/">
      <svg class="brand__mark" viewBox="0 0 48 48" aria-hidden="true">
        <rect width="48" height="48" rx="12" fill="#0b5f8a"></rect>
        <path
          d="M24 11c5 6.5 8.5 11 8.5 15.5A8.5 8.5 0 0 1 24 35a8.5 8.5 0 0 1-8.5-8.5C15.5 22 19 17.5 24 11Z"
          fill="#12a594"></path>
        <path
          d="M24 19c2.4 3.2 4 5.4 4 7.6a4 4 0 0 1-8 0c0-2.2 1.6-4.4 4-7.6Z"
          fill="#eafaf7"></path>
      </svg>
      <span>
        <span class="brand__name">{site.name}</span>
        <span class="brand__tag">{site.tagline}</span>
      </span>
    </a>

    <nav class="nav" aria-label="Navigasi utama">
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      <a class="nav__cta" href="#kontak">Minta penawaran</a>
    </nav>
  </div>
</header>
