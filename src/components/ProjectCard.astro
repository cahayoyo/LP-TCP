---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  p: {
    title: string;
    tag: string;
    location?: string;
    spec?: string;
    specIcon?: string;
    image: ImageMetadata | string;
    alt: string;
  };
}

const { p } = Astro.props;
---

<li class="pr-card">
  {typeof p.image === 'string' ? (
    <img src={p.image} alt={p.alt} width="640" height="480" loading="lazy" />
  ) : (
    <Image src={p.image} alt={p.alt} width={640} format="webp" quality={80} loading="lazy" />
  )}
  <span class="pr-card__tag">{p.tag}</span>
  <div class="pr-card__info">
    <h3>{p.title}</h3>
    {(p.location || p.spec) && (
      <p class="pr-card__meta">
        {p.location && (
          <span>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
              <circle cx="12" cy="10" r="3"></circle>
            </svg>
            {p.location}
          </span>
        )}
        {p.spec && (
          <span>
            {p.specIcon === 'pipe' ? (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M3 13h18"></path>
                <path d="M3 11v4M6 11v4M18 11v4M21 11v4"></path>
                <path d="M12 13V9"></path>
                <circle cx="12" cy="7" r="1.6"></circle>
              </svg>
            ) : (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                <path d="M12 3c3.5 4.6 6 8 6 11a6 6 0 0 1-12 0c0-3 2.5-6.4 6-11Z"></path>
              </svg>
            )}
            {p.spec}
          </span>
        )}
      </p>
    )}
  </div>
</li>
