---
import { Image } from 'astro:assets';
import { ipaRegulation, ipaStandards } from '../data/site';
import sniMark from '../assets/logo-sni.png';
import waterBackground from '../assets/sni-water.webp';
---

<section class="sni-panel" aria-labelledby="sni-title">
  <Image
    src={waterBackground}
    alt=""
    aria-hidden="true"
    width={1700}
    widths={[480, 800, 1200, 1700]}
    sizes="(max-width: 1700px) 100vw, 1700px"
    format="webp"
    quality={65}
    loading="lazy"
    class="sni-panel__background"
  />
  <div class="sni-panel__content">
    <div class="sni-panel__head">
      <p class="sni-panel__eyebrow">{ipaStandards.eyebrow}</p>
      <h3 id="sni-title">{ipaStandards.heading} <span>{ipaStandards.abbreviation}</span></h3>
      <p class="sni-panel__description">{ipaStandards.description}</p>
    </div>

    <ul class="sni-grid">
      {ipaStandards.items.map((standard) => (
        <li class="sni-card">
          <span class="sni-card__mark" aria-hidden="true">
            <Image src={sniMark} alt="" width={72} height={72} loading="lazy" />
          </span>
          <div class="sni-card__copy">
            <h4>{standard.code}</h4>
            <p>{standard.description}</p>
          </div>
          <span class="sni-card__icon" aria-hidden="true">
            <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              {standard.icon === 'specification' && (
                <>
                  <path d="M27 6H12a3 3 0 0 0-3 3v29a3 3 0 0 0 3 3h14M27 6v9h9l-9-9ZM36 15v9M16 14h5M16 22h10M16 29h5" />
                  <circle cx="33" cy="34" r="9" />
                  <path d="m29 34 3 3 5-6" />
                </>
              )}
              {standard.icon === 'planning' && (
                <>
                  <path d="M14 12h25v28H14M9 7h5v33H9a4 4 0 0 1-4-4V11a4 4 0 0 1 4-4ZM9 32H5M20 19h13v14H20ZM24 19v7h9M20 38h13M25 15v4M29 33v3" />
                </>
              )}
              {standard.icon === 'maintenance' && (
                <>
                  <path d="m20 7 1-4h6l1 4 4 2 4-1 3 5-3 3v5l3 3-3 5-4-1-4 2-1 4h-6l-1-4-4-2-4 1-3-5 3-3v-5l-3-3 3-5 4 1 4-2Z" />
                  <circle cx="24" cy="18" r="6" />
                  <path d="m34 29 3-2 4 3-1 3 2 3 3 1-1 5-4 1-2 3-5-2v-4l-2-3-3-1 1-4 5-3Z" />
                  <circle cx="36" cy="36" r="3" />
                </>
              )}
            </svg>
          </span>
        </li>
      ))}
    </ul>
  </div>
</section>

<section class="regulation-panel" aria-labelledby="regulation-title">
  <span class="regulation-panel__icon" aria-hidden="true">
    <svg viewBox="0 0 96 96">
      <path fill="#fff" d="M30 23h36a7 7 0 0 1 7 7v46a7 7 0 0 1-7 7H30a7 7 0 0 1-7-7V30a7 7 0 0 1 7-7Z" />
      <path fill="#fff" d="M38 20a10 10 0 0 1 20 0h7v15H31V20h7Z" />
      <circle cx="48" cy="20" r="4" fill="#0963df" />
      <path fill="none" stroke="#0963df" stroke-width="6" stroke-linecap="round" d="M36 46h24M36 59h24M36 72h15" />
      <circle cx="70" cy="71" r="16" fill="#fff" stroke="#0963df" stroke-width="5" />
      <path fill="none" stroke="#0963df" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" d="m62 71 6 6 11-13" />
    </svg>
  </span>
  <span class="regulation-panel__divider" aria-hidden="true"></span>
  <div class="regulation-panel__copy">
    <div class="regulation-panel__title">
      <h3 id="regulation-title">{ipaRegulation.heading}</h3>
      <span aria-hidden="true"></span>
    </div>
    <ul>
      {ipaRegulation.lines.map((line) => <li>{line}</li>)}
    </ul>
  </div>
  <svg class="regulation-panel__watermark" viewBox="0 0 320 220" fill="none" aria-hidden="true">
    <path d="M58 29 29 46a27 27 0 0 0-10 37l73 126M151 24l-21 12a28 28 0 0 0-10 38l77 133" />
    <g transform="rotate(23 245 107)">
      <rect x="188" y="31" width="108" height="151" rx="18" />
      <path d="M218 60h49M218 83h49M218 106h39" />
    </g>
  </svg>
</section>
